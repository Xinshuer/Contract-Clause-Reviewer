# Copy to .env and fill in what you have. Everything is optional.

# --- model backend ---------------------------------------------------------
# auto  = Anthropic if a key is present, else local LM Studio if it answers, else mock
# live  = Anthropic API      local = OpenAI-compatible local server      mock = rule-based, no model
CLAUSECHECK_MODE=auto
CLAUSECHECK_MODEL=claude-opus-5
CLAUSECHECK_EFFORT=medium          # low | medium | high | xhigh | max  (Anthropic only)
CLAUSECHECK_MAX_STEPS=6            # max model calls per clause (tool loop bound)
# CLAUSECHECK_FALLBACKS=1          # Anthropic server-side refusal fallback (beta)

# ANTHROPIC_API_KEY=sk-ant-...

# --- local model (LM Studio / llama.cpp server / Ollama, OpenAI-compatible) --
CLAUSECHECK_LOCAL_BASE_URL=http://127.0.0.1:1234/v1
CLAUSECHECK_LOCAL_MODEL=qwen38
CLAUSECHECK_LOCAL_TEMPERATURE=0.3
CLAUSECHECK_LOCAL_MAX_TOKENS=3000
# CLAUSECHECK_LOCAL_FULL_CONTRACT=1   # full contract in the prompt instead of an index (slower prefill)

# --- observability (optional) ---------------------------------------------
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com   # or http://localhost:3000 for self-hosted

# --- evals ----------------------------------------------------------------
CLAUSECHECK_EVAL_RUNS=3
