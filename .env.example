# Copy to .env and fill in what you have. Everything is optional; .env is git-ignored.

# --- model backend ---------------------------------------------------------
# auto     = Anthropic key -> live; DEEPSEEK_API_KEY -> deepseek; local server up -> local; else mock
# live     = Anthropic API           deepseek = DeepSeek API (OpenAI-compatible)
# local    = LM Studio / llama.cpp   mock     = rule-based, no model
CLAUSECHECK_MODE=auto
CLAUSECHECK_PROMPT_VERSION=v2      # v1 | v2 (see review.py)
CLAUSECHECK_MAX_STEPS=6            # max model calls per clause (tool loop bound)

# --- DeepSeek ----------------------------------------------------------------
DEEPSEEK_API_KEY=                  # sk-...  from https://platform.deepseek.com/api_keys
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# CLAUSECHECK_DEEPSEEK_MODEL=deepseek-chat

# --- Anthropic ---------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
CLAUSECHECK_MODEL=claude-opus-5
CLAUSECHECK_EFFORT=medium          # low | medium | high | xhigh | max  (Anthropic only)
# CLAUSECHECK_FALLBACKS=1          # server-side refusal fallback (beta)

# --- local model (LM Studio / llama.cpp server / Ollama) ---------------------
CLAUSECHECK_LOCAL_BASE_URL=http://127.0.0.1:1234/v1
CLAUSECHECK_LOCAL_MODEL=qwen38
# CLAUSECHECK_LOCAL_API_KEY=       # only if your server requires one

# --- shared by deepseek + local ----------------------------------------------
CLAUSECHECK_TEMPERATURE=0.3
CLAUSECHECK_COMPAT_MAX_TOKENS=3000
# CLAUSECHECK_JSON_MODE=json_schema   # json_schema (LM Studio) | json_object (DeepSeek); default picked per mode
# CLAUSECHECK_FULL_CONTRACT=1         # whole contract in the prompt (default: deepseek yes, local no)

# --- observability (optional) ------------------------------------------------
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com   # or http://localhost:3000 for self-hosted

# --- evals -------------------------------------------------------------------
CLAUSECHECK_EVAL_RUNS=3
